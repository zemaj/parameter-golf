{
  "description": "Single-H100 screening preset for the Scylla port of the #1176 QK-Gain + XSA11 + TTT/SLOT stack.",
  "script": "records/track_non_record_16mb/2026-04-01_Scylla_QKGain4_XSA11_TTT_SLOT/train_gpt.py",
  "launch": {
    "type": "torchrun",
    "nproc_per_node": 1,
    "executor": "runpod-screening"
  },
  "env": {
    "RUN_ID": "scylla_qkgain4_xsa11_ttt_slot_manual",
    "DATA_PATH": "./data/datasets/fineweb10B_scylla",
    "TOKENIZER_PATH": "./records/track_non_record_16mb/2026-04-01_Scylla_QKGain4_XSA11_TTT_SLOT/candidate.vocab",
    "TOKENIZER_META_PATH": "./records/track_non_record_16mb/2026-04-01_Scylla_QKGain4_XSA11_TTT_SLOT/candidate.meta.npz",
    "VOCAB_SIZE": "998",
    "MAX_WALLCLOCK_SECONDS": "600",
    "VAL_LOSS_EVERY": "200",
    "TRAIN_LOG_EVERY": "50",
    "QK_GAIN_INIT": "4.0",
    "SLOT_ENABLED": "1",
    "SLOT_STEPS": "5",
    "SLOT_LR": "0.003",
    "TTT_ENABLED": "0"
  },
  "remote": {
    "data": {
      "source": "retokenize-docs",
      "dataset_name": "fineweb10B_scylla",
      "train_shards": 80,
      "repo_id": "willdepueoai/parameter-golf",
      "remote_root": "datasets",
      "tokenizer_config": "./data/tokenizer_specs_scylla.json",
      "python_packages": [
        "tokenmonster"
      ]
    }
  },
  "notes": "Directional 1xH100 screening preset for the Scylla port of #1176. Starts SLOT-only with TTT disabled in env."
}
