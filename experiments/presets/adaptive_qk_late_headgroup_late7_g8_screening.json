{
  "description": "Baseline-parent adaptive QK screening run with the late7 adaptive gain promoted from 4 head groups to 8 per-head biases.",
  "script": "experiments/adaptive_qk/train_gpt.py",
  "launch": {
    "type": "torchrun",
    "nproc_per_node": 1,
    "executor": "runpod-screening"
  },
  "env": {
    "RUN_ID": "adaptive_qk_late_headgroup_late7_g8_screening",
    "DATA_PATH": "./data/datasets/fineweb10B_sp1024",
    "TOKENIZER_PATH": "./data/tokenizers/fineweb_1024_bpe.model",
    "VOCAB_SIZE": "1024",
    "MAX_WALLCLOCK_SECONDS": "600",
    "VAL_LOSS_EVERY": "200",
    "TRAIN_LOG_EVERY": "50",
    "ADAPTIVE_QK_ENABLE": "1",
    "ADAPTIVE_QK_MODE": "late_headgroup",
    "ADAPTIVE_QK_HEAD_GROUPS": "8",
    "ADAPTIVE_QK_LATE_START_LAYER": "7",
    "ADAPTIVE_QK_POS_START_LAYER": "8",
    "ADAPTIVE_QK_NUM_POS_BUCKETS": "8",
    "ADAPTIVE_QK_USE_TOKEN_RMS": "0",
    "ADAPTIVE_QK_LOG_DELTA_CLAMP": "0.4"
  },
  "remote": {
    "data": {
      "variant": "sp1024"
    }
  },
  "notes": "Expressivity follow-up to the late7 winner using per-head late biases."
}
