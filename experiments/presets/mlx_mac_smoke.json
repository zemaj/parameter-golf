{
  "description": "Apple Silicon MLX smoke run for a quick end-to-end validation on a local Mac.",
  "script": "train_gpt_mlx.py",
  "launch": {
    "type": "python"
  },
  "env": {
    "RUN_ID": "mlx_mac_smoke",
    "DATA_PATH": "./data/datasets/fineweb10B_sp1024",
    "TOKENIZER_PATH": "./data/tokenizers/fineweb_1024_bpe.model",
    "ITERATIONS": "200",
    "TRAIN_BATCH_TOKENS": "8192",
    "VAL_BATCH_SIZE": "8192",
    "VAL_LOSS_EVERY": "0",
    "TRAIN_LOG_EVERY": "20",
    "MAX_WALLCLOCK_SECONDS": "0",
    "MLX_MAX_MICROBATCH_TOKENS": "8192",
    "MLX_EAGER_EVAL": "0"
  },
  "notes": "Good first preset for a 32GB M1 Max or newer Apple Silicon machine. Directional only, not benchmark-comparable."
}
