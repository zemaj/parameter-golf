{
  "description": "Baseline-parent adaptive QK screening run with position-bucket and token-RMS attention temperature control.",
  "script": "experiments/adaptive_qk/train_gpt.py",
  "launch": {
    "type": "torchrun",
    "nproc_per_node": 1,
    "executor": "runpod-screening"
  },
  "env": {
    "RUN_ID": "adaptive_qk_rms_pos_screening",
    "DATA_PATH": "./data/datasets/fineweb10B_sp1024",
    "TOKENIZER_PATH": "./data/tokenizers/fineweb_1024_bpe.model",
    "VOCAB_SIZE": "1024",
    "MAX_WALLCLOCK_SECONDS": "600",
    "VAL_LOSS_EVERY": "200",
    "TRAIN_LOG_EVERY": "50",
    "ADAPTIVE_QK_ENABLE": "1",
    "ADAPTIVE_QK_NUM_POS_BUCKETS": "8",
    "ADAPTIVE_QK_USE_TOKEN_RMS": "1",
    "ADAPTIVE_QK_LOG_DELTA_CLAMP": "1.25"
  },
  "remote": {
    "data": {
      "variant": "sp1024"
    }
  },
  "notes": "First adaptive-qk isolation test: same baseline stack and budget, only Q-gain modulation is added."
}
